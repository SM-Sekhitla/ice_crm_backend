POSTGRES_DB=crm_db
POSTGRES_USER=crm
POSTGRES_PASSWORD=password


ENVIRONMENT=development
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_RATE_LIMIT=20
BACKEND_PORT='5002'
APP_HOST=0.0.0.0
APP_PORT='5002'
WEB_CONCURRENCY=1
DATABASE_URL='postgresql+asyncpg://crm:password@127.0.0.1:5433/crm_db'
AUTO_CREATE_TABLES=false
APP_NAME=ICE-CRM
API_V1_PREFIX=/api/v1
FRONTEND_BASE_URL='http://localhost:5173'



EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

BOOTSTRAP_SECRET=
DEFAULT_PLATFORM_ADMIN_USERNAME=platform-admin
DEFAULT_PLATFORM_ADMIN_EMAIL=platform-admin@example.com
DEFAULT_PLATFORM_ADMIN_PASSWORD=

EMAIL_PROVIDER=smtp

BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@example.com
BREVO_FROM_NAME=ICE Business Development

LOG_LEVEL=INFO
LOG_DIR=logs


PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=5050
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# EMAIL_PROVIDER: smtp or brevo. EMAIL_DELIVERY_ENABLED controls real sending.
# Brevo requires an API key and a verified sender matching BREVO_FROM_EMAIL.
POSTGRES_PORT='5433'
DOCKER_DATABASE_URL='postgresql+asyncpg://crm:password@db:5432/crm_db'

# On API startup, create this email as Super Admin if it does not exist.
# Set a 12-128 character password in .env. Existing accounts/passwords are never reset.
INVITATION_EXPIRY_HOURS='24'
SMTP_FROM_EMAIL=''
SMTP_FROM_NAME='ICE Business Development'
